<form action="" method="POST" class="card mb-3" id="cryptapi-payment-form"
      data-select-url="{{ select_url|e('html_attr') }}"
      data-confirm-url="{{ confirm_url|e('html_attr') }}"
      data-refresh-url="{{ refresh_url|e('html_attr') }}"
      data-show-fee="{{ show_fee ? '1' : '0' }}"
      data-fee-label="{{ text_fee|e('html_attr') }}"
      data-fee="{{ fee_text|e('html_attr') }}"
      data-total-label="{{ column_total|e('html_attr') }}"
      data-total="{{ total_text|e('html_attr') }}"
      data-error-request="{{ error_request|e('html_attr') }}">
    <div class="card-header">
        <legend class="card-title border-bottom-0 pb-0">{{ title }}</legend>
    </div>
    <div class="card-body pb-2">
        <fieldset id="payment">
            <div class="form-group">
                {% for ticker, coin in cryptocurrencies %}
                    <div class="col-sm-12 mb-3 d-flex align-items-center">
                        <input class="form-check-inline me-2" type="radio" name="cryptapi_coin" id="cryptapi_coin_{{ ticker }}" value="{{ ticker }}" {% if selected==ticker %}checked{% endif %}/>
                        <img style="pointer-events: none !important;" width="24" class="img-fluid ms-1 me-2" src="{{ coin['logo'] }}" />
                        <label class="form-check-label" for="cryptapi_coin_{{ ticker }}">{{ text_paywith }} {{ coin['name'] }}</label>
                    </div>
                {% endfor %}
            </div>
        </fieldset>
        <div id="cryptapi-error" class="alert alert-danger mb-0" role="alert" style="display: none;"></div>
        <div class="mt-4">
            <small>Powered by <a href="https://cryptapi.io" target="_blank">CryptAPI</a></small>
        </div>
    </div>
</form>
<div class="d-inline-block pt-2 pd-2 w-100 text-end">
    <button type="button" id="button-confirm" class="btn btn-primary">{{ button_confirm }}</button>
</div>
<script type="text/javascript"><!--
(function (init) {
    // Some themes load or defer jQuery after this markup; wait for it instead of failing.
    if (window.jQuery) {
        init(window.jQuery);
    } else {
        window.addEventListener('load', function () {
            if (window.jQuery) {
                init(window.jQuery);
            }
        });
    }
})(function ($) {
    var form = $('#cryptapi-payment-form');
    var button = $('#button-confirm');
    var errorBox = $('#cryptapi-error');

    // .attr, not .data: jQuery's .data turns numeric-looking strings into numbers.
    function setting(name) {
        return form.attr('data-' + name) || '';
    }

    // OC 4.0.2+ core common.js defines .button('loading'). Older versions and some
    // themes don't (Bootstrap's own .button ignores 'loading'), so disable directly
    // too. Order matters: core's helper saves the disabled state it finds.
    function setLoading(on) {
        if (typeof $.fn.button === 'function') {
            button.button(on ? 'loading' : 'reset');
        }
        button.prop('disabled', on).toggleClass('loading', on);
    }

    // Shown inside our own form: not every theme has core's #alert container, and
    // one-page checkouts may hide it behind their own overlay.
    function showError(message) {
        errorBox.text(message).show();
    }

    // Add the fee to core's order totals. Clone the last row so the columns match
    // whatever the table (or theme) uses.
    if (setting('show-fee') === '1') {
        var tfoot = $('#checkout-confirm .table tfoot').first();
        var last = tfoot.find('tr').last();

        if (last.length && !tfoot.data('cryptapi-fee')) {
            var row = function (label, value) {
                var r = last.clone();
                r.children().first().empty().append($('<strong>').text(label));
                r.children().last().text(value);
                return r;
            };
            var feeRow = row(setting('fee-label'), setting('fee'));

            last.after(feeRow);
            feeRow.after(row(setting('total-label'), setting('total')));
            last.remove();
            tfoot.data('cryptapi-fee', 1);
        }
    }

    // Remember the coin so it survives core reloading this section (terms, comment,
    // address changes). Refresh the totals only when a fee depends on the coin.
    form.on('change', 'input[name="cryptapi_coin"]', function () {
        errorBox.hide();

        $.post(setting('select-url'), form.serialize()).always(function () {
            if (setting('show-fee') === '1' && $('#checkout-confirm').length) {
                $('#checkout-confirm').load(setting('refresh-url'));
            }
        });
    });

    button.on('click', function () {
        errorBox.hide();

        $.ajax({
            url: setting('confirm-url'),
            type: 'post',
            data: form.find('input[name="cryptapi_coin"]:checked').serialize(),
            dataType: 'json',
            cache: false,
            timeout: 60000,
            beforeSend: function () {
                setLoading(true);
            },
            success: function (json) {
                if (json['redirect']) {
                    location = json['redirect'];   // keep the spinner while the page changes
                    return;
                }

                // The server dropped a stale order (see confirm()). Reloading the confirm
                // section makes OpenCart create a fresh one; confirm again, once.
                if (json['refresh']) {
                    if ($('#checkout-confirm').length && !window.cryptapiRefreshed) {
                        window.cryptapiRefreshed = true;
                        $('#checkout-confirm').load(setting('refresh-url'), function () {
                            $('#button-confirm').trigger('click');
                        });
                    } else {
                        location.reload();
                    }
                    return;
                }

                setLoading(false);

                if (json['error'] && json['error']['warning']) {
                    showError(json['error']['warning']);
                }
            },
            error: function (xhr, ajaxOptions, thrownError) {
                setLoading(false);
                showError(setting('error-request'));
                console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    });
});
//--></script>
